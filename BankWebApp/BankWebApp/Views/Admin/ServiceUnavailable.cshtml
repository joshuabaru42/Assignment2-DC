@{
    @* MEMBER 3 - PART B REQUIREMENT 9: Fallback view shown when the banking API cannot be reached. *@
    ViewData["Title"] = "Service Unavailable";
}

<div class="alert alert-warning" role="alert">
    <h1 class="h4">Banking service temporarily unavailable</h1>
