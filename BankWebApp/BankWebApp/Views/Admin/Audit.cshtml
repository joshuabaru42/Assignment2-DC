@model BankWebApp.Models.AuditTrailViewModel
@* =====================================================
   MEMBER 3 - PART B REQUIREMENT 8
   Administrator audit-trail filtering and paged review.
   Reference: https://learn.microsoft.com/aspnet/core/mvc/views/tag-helpers/intro
   ===================================================== *@
@{
    ViewData["Title"] = "Audit Trail";
    var previousPage = Math.Max(1, Model.Results.Page - 1);
    var nextPage = Model.Results.Page + 1;
}

<h1>Audit Trail</h1>
<form method="get" class="row g-3 mb-3">
    <div class="col-md-2"><label asp-for="ActorUserId" class="form-label">Actor user ID</label><input asp-for="ActorUserId" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="Action" class="form-label">Action</label><input asp-for="Action" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="EntityType" class="form-label">Entity type</label><input asp-for="EntityType" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="FromUtc" class="form-label">From (UTC)</label><input asp-for="FromUtc" type="datetime-local" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="ToUtc" class="form-label">To (UTC)</label><input asp-for="ToUtc" type="datetime-local" class="form-control" /></div>
    <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-primary">Filter</button></div>
</form>

<div class="table-responsive"><table class="table table-striped table-sm align-middle">
    <thead><tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Entity</th><th>Result</th><th>Details</th></tr></thead>
    <tbody>
    @foreach (var log in Model.Results.Items)
    {
        <tr><td>@log.OccurredAtUtc.ToString("u")</td><td>@log.ActorUserId</td><td>@log.Action</td><td>@log.EntityType @log.EntityId</td><td><span class="badge @(log.Succeeded ? "text-bg-success" : "text-bg-danger")">@(log.Succeeded ? "Succeeded" : "Failed")</span></td><td>@log.Details</td></tr>
    }
    </tbody>
</table></div>

<p class="text-muted">Showing @Model.Results.Items.Count of @Model.Results.TotalCount audit events.</p>
<nav aria-label="Audit pages"><ul class="pagination">
    <li class="page-item @(Model.Results.Page <= 1 ? "disabled" : "")"><a class="page-link" asp-action="Audit" asp-route-actorUserId="@Model.ActorUserId" asp-route-action="@Model.Action" asp-route-entityType="@Model.EntityType" asp-route-fromUtc="@Model.FromUtc" asp-route-toUtc="@Model.ToUtc" asp-route-page="@previousPage">Previous</a></li>
    <li class="page-item disabled"><span class="page-link">Page @Model.Results.Page</span></li>
    <li class="page-item @(Model.Results.Page * Model.Results.PageSize >= Model.Results.TotalCount ? "disabled" : "")"><a class="page-link" asp-action="Audit" asp-route-actorUserId="@Model.ActorUserId" asp-route-action="@Model.Action" asp-route-entityType="@Model.EntityType" asp-route-fromUtc="@Model.FromUtc" asp-route-toUtc="@Model.ToUtc" asp-route-page="@nextPage">Next</a></li>
</ul></nav>
