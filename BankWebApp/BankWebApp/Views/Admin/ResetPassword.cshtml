@model BankWebApp.Models.AdminPasswordResetViewModel
@* =====================================================
   MEMBER 3 - PART B REQUIREMENT 6
   Form for administrators to set a new user password.
   Reference: https://learn.microsoft.com/aspnet/core/mvc/views/working-with-forms
   ===================================================== *@
@{
    ViewData["Title"] = "Reset User Password";
}

<h1>Reset User Password</h1>
<p class="text-muted">Set a new password for this user.</p>
<form asp-action="ResetPassword" method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="UserId" type="hidden" />
    <div class="col-md-6"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" /><span asp-validation-for="NewPassword" class="text-danger"></span></div>
    <div class="col-12"><button type="submit" class="btn btn-warning">Reset password</button> <a asp-action="Users" class="btn btn-secondary">Cancel</a></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
