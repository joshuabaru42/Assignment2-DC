@model IEnumerable<BankWebApp.Models.Account>

@{
    ViewData["Title"] = "Account Dashboard";
}

<div class="container mt-4">
    <h2>Your Account Dashboard</h2>
    <hr />

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover mt-3 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Account Number</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model)
                {
                    <tr>
                        <td class="fw-bold">@account.AccountNumber</td>
                        <td>@account.Balance.ToString("C")</td>
                        <td>
                            @if (account.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Transactions" asp-route-accountId="@account.Id" class="btn btn-sm btn-outline-primary me-1">
                                Transactions
                            </a>
                            <a asp-action="Deposit" asp-route-accountId="@account.Id" class="btn btn-sm btn-success me-1">
                                + Deposit
                            </a>
                            <a asp-action="Withdraw" asp-route-accountId="@account.Id" class="btn btn-sm btn-warning me-1">
                                - Withdraw
                            </a>
                            <a asp-action="Transfer" asp-route-accountId="@account.Id" class="btn btn-sm btn-info text-white">
                                ⇄ Transfer
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No accounts found for this user.</div>
    }
</div>