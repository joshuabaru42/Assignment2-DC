@{
    ViewData["Title"] = "Deposit Funds";
    var accountId = ViewBag.AccountId;
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Deposit Funds</h2>
    <hr />

    <form asp-action="Deposit" method="post" asp-antiforgery="true">
        <input type="hidden" name="accountId" value="@accountId" />

        <div class="mb-3">
            <label class="form-label fw-bold">Amount ($)</label>
            <input type="number" step="0.01" name="amount" class="form-control" required min="0.01" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Description</label>
            <input type="text" name="description" class="form-control" value="ATM Deposit" />
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Transactions" asp-route-accountId="@accountId" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-success">Confirm Deposit</button>
        </div>
    </form>
</div>