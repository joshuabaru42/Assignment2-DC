{
  "info": {
    "_postman_id": "a98f6a20-5990-4373-a8cb-7103d1a95010",
    "name": "BankService Part A",
    "description": "Member 3 Part A API checks. Set adminCookie after Member 1 implements login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5123" },
    { "key": "adminCookie", "value": "" },
    { "key": "userId", "value": "1" },
    { "key": "accountId", "value": "1" },
    { "key": "destinationAccountId", "value": "2" }
  ],
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Get all accounts",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/accounts" }
        },
        {
          "name": "Get account by ID",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/accounts/{{accountId}}" }
        },
        {
          "name": "Get missing account - structured 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/accounts/999999"
          }
        },
        {
          "name": "Create account for missing user - structured 422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": 999999,\n  \"accountNumber\": \"TEST-001\"\n}" },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{userId}},\n  \"accountNumber\": \"POSTMAN-{{$randomInt}}\"\n}" },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "Deactivate account",
          "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/api/accounts/{{accountId}}/deactivate" }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountId\": {{accountId}},\n  \"amount\": 100,\n  \"description\": \"Postman deposit\"\n}" },
            "url": "{{baseUrl}}/api/transactions/deposit"
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountId\": {{accountId}},\n  \"amount\": 10,\n  \"description\": \"Postman withdrawal\"\n}" },
            "url": "{{baseUrl}}/api/transactions/withdraw"
          }
        },
        {
          "name": "Withdraw from missing account - structured 404",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountId\": 999999,\n  \"amount\": 10\n}" },
            "url": "{{baseUrl}}/api/transactions/withdraw"
          }
        },
        {
          "name": "Transfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sourceAccountId\": {{accountId}},\n  \"destinationAccountId\": {{destinationAccountId}},\n  \"amount\": 10,\n  \"description\": \"Postman transfer\"\n}" },
            "url": "{{baseUrl}}/api/transactions/transfer"
          }
        },
        {
          "name": "Transfer to same account - structured 422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sourceAccountId\": {{accountId}},\n  \"destinationAccountId\": {{accountId}},\n  \"amount\": 10\n}" },
            "url": "{{baseUrl}}/api/transactions/transfer"
          }
        }
      ]
    },
    {
      "name": "Administration",
      "item": [
        {
          "name": "Search users without login - structured 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/users?search=admin&page=1&pageSize=20"
          }
        },
        {
          "name": "Search users as administrator",
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "{{adminCookie}}" }],
            "url": "{{baseUrl}}/api/admin/users?search=admin&page=1&pageSize=20"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login as seeded administrator",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"seeduser01\",\n  \"password\": \"DemoUser01!2026\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login with invalid credentials - 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"seeduser01\",\n  \"password\": \"invalid\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Users and Profiles",
      "item": [
        { "name": "Register customer", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"postman{{$randomInt}}\",\n  \"name\": \"Postman User\",\n  \"email\": \"postman{{$randomInt}}@example.test\",\n  \"address\": \"Test Address\",\n  \"phone\": \"0400000000\",\n  \"password\": \"PostmanTest!2026\"\n}" }, "url": "{{baseUrl}}/api/users" } },
        { "name": "Get profile by ID", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users/{{userId}}" } },
        { "name": "Update profile", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Postman User\",\n  \"email\": \"seeduser01@example.test\",\n  \"address\": \"Updated Address\",\n  \"phone\": \"0400000000\"\n}" }, "url": "{{baseUrl}}/api/users/{{userId}}" } },
        { "name": "Get profile by username", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users/by-username/seeduser01" } },
        { "name": "Get profile by email", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users/by-email?email=seeduser01@example.test" } },
        { "name": "Deactivate user", "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/api/users/{{userId}}/deactivate" } },
        { "name": "Upload profile picture", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "multipart/form-data" }], "url": "{{baseUrl}}/api/users/{{userId}}/picture" } },
        { "name": "Get profile picture", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users/{{userId}}/picture" } }
      ]
    }
  ]
}
